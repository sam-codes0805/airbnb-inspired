<%- include("../partials/head") %>
</head>
<body>
  <%- include("../partials/nav") %>
  <h1 class="my-5 mx-10 text-2xl font-semibold text-red-400 text-center border-b-2 border-red-400 pb-2">Home details</h1>

<main class="max-w-4xl mx-auto my-10 px-4">
  <!-- House Photo -->
  <div class="mb-6">
    <img 
      src="uploads/<%= home.photo %>" 
      class="h-80 w-full max-w-2xl object-cover rounded-2xl shadow-md block mx-auto" 
      alt="<%= home.housename %>"
    >
  </div>

  <!-- House Details Card -->
  <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-gray-100 max-w-2xl mx-auto">
    
    <!-- Title, Location, Rating & Price -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-gray-100 pb-4 mb-4 gap-2">
      <div>
        <h1 class="text-2xl font-bold text-gray-800"><%= home.housename %></h1>
        <p class="text-gray-500 flex items-center gap-1 mt-1 text-sm">
          <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <%= home.location %>
        </p>
      </div>
      
      <div class="text-left sm:text-right flex sm:flex-col items-center sm:items-end justify-between w-full sm:w-auto mt-2 sm:mt-0">
        <div class="inline-flex items-center gap-1 bg-red-50 text-red-500 font-semibold px-3 py-1 rounded-full text-sm">
          <span>★</span>
          <span><%= home.rating %></span>
        </div>
        <div class="text-xl font-bold text-red-400 mt-1">
          &#8377;<%= home.price %> <span class="text-xs font-normal text-gray-500">/ night</span>
        </div>
      </div>
    </div>

    <!-- Home Description -->
    <div class="my-6">
      <h2 class="text-lg font-semibold text-gray-800 mb-2">About this home</h2>
      <p class="text-gray-600 leading-relaxed text-sm md:text-base">
        <%= home.desc || "Welcome to " + home.housename + "! Enjoy a comfortable stay featuring modern amenities, beautiful surrounding views, and easy access to local attractions. Perfect for families, couples, or solo travelers seeking a relaxing getaway." %>
      </p>
    </div>

    <!-- Download House Rules Link -->
    <div class="my-6 p-4 bg-red-50 border border-red-100 rounded-xl flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="p-2 bg-red-100 rounded-lg text-red-500 shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <div>
          <h3 class="font-medium text-gray-800 text-sm">House Rules</h3>
          <p class="text-xs text-gray-500">Read policies & guidelines before booking</p>
        </div>
      </div>
      <a 
        href="/rules/<%= home._id %>" 
        class="inline-flex items-center text-xs md:text-sm text-red-500 font-semibold border border-red-400 px-3 py-1.5 rounded-lg hover:bg-red-400 hover:text-white transition-colors duration-200 shrink-0 ml-2"
      >
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Download Rules
      </a>
    </div>

    <!-- Actions (Book Now & Favorite) -->
    <div class="mt-8 flex items-center justify-center space-x-4 pt-4 border-t border-gray-100">
      <a class="bg-red-400 text-white font-medium w-40 text-center rounded-xl py-2.5 px-4 hover:bg-red-500 transition-colors shadow-sm" href="/bookings">
        Book Now
      </a>
      <form class="cursor-pointer bg-red-400 text-white font-medium w-40 text-center rounded-xl py-2.5 px-4 hover:bg-red-500 transition-colors shadow-sm" action="/add-fav" method="post">
              <input type="submit" class="cursor-pointer" value="Add to favourite">
              <input type="hidden" value="<%= home._id %>" name="_id" id="id">
      </form>
    </div>

  </div>
</main>
</body>
</html>