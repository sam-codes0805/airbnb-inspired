<%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>
    <main class="min-h-[calc(100vh-4rem)] bg-stone-50 px-4 py-10 sm:py-14">
      <section class="mx-auto max-w-2xl">
        <div class="mb-8 text-center">
          <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-red-500">Welcome to Airbnb</p>
          <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">Create your account</h1>
          <p class="mt-3 text-gray-600">Join as a guest or start hosting your space.</p>
        </div>

        <form action="/sign-up" method="POST" class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
          <%- include('../partials/errors') %>
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label for="firstname" class="mb-2 block text-sm font-medium text-gray-700">First name</label>
              <input id="firstname" type="text" name="firstname" autocomplete="given-name" required
                class="w-full rounded-md border border-gray-300 px-3 py-2.5 text-gray-900 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-100" />
            </div>
            <div>
              <label for="lastname" class="mb-2 block text-sm font-medium text-gray-700">Last name</label>
              <input id="lastname" type="text" name="lastname" autocomplete="family-name" required
                class="w-full rounded-md border border-gray-300 px-3 py-2.5 text-gray-900 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-100" />
            </div>
            <div class="sm:col-span-2">
              <label for="email" class="mb-2 block text-sm font-medium text-gray-700">Email address</label>
              <input id="email" type="email" name="email" autocomplete="email" required
                class="w-full rounded-md border border-gray-300 px-3 py-2.5 text-gray-900 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-100" />
            </div>
            <div>
              <label for="password" class="mb-2 block text-sm font-medium text-gray-700">Password</label>
              <input id="password" type="password" name="password" autocomplete="new-password" required
                class="w-full rounded-md border border-gray-300 px-3 py-2.5 text-gray-900 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-100" />
            </div>
            <div>
              <label for="confirmPassword" class="mb-2 block text-sm font-medium text-gray-700">Confirm password</label>
              <input id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password" required
                class="w-full rounded-md border border-gray-300 px-3 py-2.5 text-gray-900 outline-none transition focus:border-red-500 focus:ring-2 focus:ring-red-100" />
            </div>
            <fieldset class="sm:col-span-2">
              <legend class="mb-2 block text-sm font-medium text-gray-700">I want to join as</legend>
              <div class="grid grid-cols-2 gap-3">
                <label class="cursor-pointer">
                  <input class="peer sr-only" type="radio" name="userType" value="guest" required />
                  <span class="block rounded-md border border-gray-300 px-4 py-3 text-center text-sm font-medium text-gray-700 transition hover:border-red-300 peer-checked:border-red-500 peer-checked:bg-red-50 peer-checked:text-red-700 peer-focus-visible:ring-2 peer-focus-visible:ring-red-500">Guest</span>
                </label>
                <label class="cursor-pointer">
                  <input class="peer sr-only" type="radio" name="userType" value="host" required />
                  <span class="block rounded-md border border-gray-300 px-4 py-3 text-center text-sm font-medium text-gray-700 transition hover:border-red-300 peer-checked:border-red-500 peer-checked:bg-red-50 peer-checked:text-red-700 peer-focus-visible:ring-2 peer-focus-visible:ring-red-500">Host</span>
                </label>
              </div>
            </fieldset>
            <div class="sm:col-span-2">
              <label class="flex cursor-pointer items-start gap-3 text-sm text-gray-600">
                <input type="checkbox" name="terms" value="accepted" required
                  class="mt-0.5 h-4 w-4 shrink-0 accent-red-500 focus:ring-red-500" />
                <span>I agree to the terms and conditions.</span>
              </label>
            </div>
            <div class="sm:col-span-2">
              <button type="submit" class="w-full rounded-md bg-red-500 px-4 py-3 font-semibold text-white transition hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2">
                Create account
              </button>
              <p class="mt-5 text-center text-sm text-gray-600">Already have an account? <a href="/login" class="font-semibold text-red-600 hover:text-red-700">Log in</a></p>
            </div>
          </div>
        </form>
      </section>
    </main>
</body>
</html>