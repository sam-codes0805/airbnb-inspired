<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto px-4 my-10 max-w-6xl">

  <!-- Heading -->
  <div class="text-center mb-10">
    <h2 class="text-3xl md:text-4xl text-red-500 font-bold">Our registered homes</h2>
    <p class="mt-2 text-gray-500">Browse, compare and save your favourites</p>
    <div class="w-20 h-1 bg-red-400 rounded-full mx-auto mt-4"></div>
  </div>

  <!-- Cards grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
    <% registeredHomes.forEach(home => { %>
      <div class="group bg-white rounded-2xl shadow-md overflow-hidden border border-red-100
                  hover:shadow-xl hover:-translate-y-1 transition duration-300 flex flex-col">

        <!-- Image + rating badge -->
        <div class="relative overflow-hidden">
          <img src="/uploads/<%= home.photo %>" alt="<%= home.housename %>"
               class="w-full h-52 object-cover group-hover:scale-105 transition duration-500">
          <div class="absolute top-3 right-3 bg-white/90 backdrop-blur rounded-full px-3 py-1
                      flex items-center shadow">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                 class="w-4 h-4 text-yellow-400 mr-1">
              <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm font-semibold text-gray-700"><%= home.rating %></span>
          </div>
        </div>

        <!-- Content -->
        <div class="p-5 flex flex-col flex-1">
          <h3 class="text-xl font-semibold text-gray-800 truncate"><%= home.housename %></h3>
          <p class="text-gray-500 text-sm mt-1 flex items-center">
            <i class="fas fa-map-marker-alt text-red-400 mr-2"></i>
            <span class="truncate"><%= home.location %></span>
          </p>

          <div class="mt-5 pt-4 border-t border-red-100">
            <div class="mb-4">
              <span class="text-xl font-bold text-red-500">Rs <%= home.price %></span>
              <span class="text-sm text-gray-500"> / night</span>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3">
              <a href="/homes/<%= home._id %>"
                 class="flex-1 text-center border border-red-400 text-red-400 text-sm font-medium
                        rounded-xl py-2 px-4 hover:bg-red-400 hover:text-white transition">
                Details
              </a>
              <%- include('../partials/favButton', { home: home, compact: false}) %>
            </div>
          </div>
        </div>

      </div>
    <% }) %>
  </div>

</main>
  </body>
</html>
